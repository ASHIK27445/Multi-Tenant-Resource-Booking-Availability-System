{
  "name": "multi-tenant-booking-system",
  "version": "1.0.0",
  "description": "Multi-tenant resource booking and availability system",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
